# —— Database (Phase 1 Postgres) ——
# Local Docker: docker compose up -d
DATABASE_URL=postgresql://facetai:facetai@127.0.0.1:5432/facetai?schema=public

# Signed session cookie secret. REQUIRED in production — the app refuses to
# start signing sessions with a real secret if this is unset in prod.
SESSION_SECRET=change-me-to-a-long-random-string

# Encrypts Meta Page access tokens at rest (AES-256-GCM).
# REQUIRED in production: these are your customers' credentials, and saving a
# Page connection throws rather than storing one in plaintext without this.
# Any length — it is hashed to a 256-bit key.
#
# Guard it like a database password. If you lose or change it, existing tokens
# cannot be decrypted and every connected Page has to be reconnected by hand.
# After setting it on a database that predates encryption, run once:
#   npm run db:encrypt-tokens
TOKEN_ENCRYPTION_KEY=change-me-to-a-long-random-string

# Super-admin email for the cross-tenant /admin/tenants console.
# Only this exact email gets cross-tenant access — a regular tenant's
# "admin" role does NOT. Set this to your own operator email in production;
# the demo value below only works for the seeded local demo tenant.
SUPER_ADMIN_EMAIL=admin@demo.replypilot.local

# Optional AI cost estimate (USD per 1k tokens) for dashboard KPI
# AI_COST_PER_1K=0.002

# Optional embedding model (defaults to text-embedding-3-small)
# AI_EMBED_MODEL=text-embedding-3-small
#
# Embeddings can point somewhere other than replies. Set these when the reply
# provider serves no /embeddings route — Groq is the common case — otherwise
# switching providers silently drops knowledge retrieval to keyword-only.
# Both default to the chat base URL / key, so leaving them unset changes nothing.
# AI_EMBED_BASE_URL=http://127.0.0.1:11434/v1
# AI_EMBED_API_KEY=

# Leads (Phase 1 / P0)
# Optional: Google Apps Script / Zapier / Make webhook URL.
# When set, every lead is POSTed as JSON to this endpoint.
LEADS_WEBHOOK_URL=

# Orders (Messenger bot)
# Same Apps Script pattern as leads — append order rows to a Sheet.
ORDERS_WEBHOOK_URL=
# Alias also accepted in code:
# ORDERS_SHEET_WEBHOOK_URL=

# WhatsApp number in international format (no +). Used for wa.me links.
NEXT_PUBLIC_WHATSAPP_NUMBER=8801601677122

# Public site URLs (landing /login /dashboard)
NEXT_PUBLIC_SITE_NAME=ReplyPilot AI
NEXT_PUBLIC_APP_URL=https://app.replypilotai.shop
# Local dev: NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional real m.me / Messenger link — only set when you have a live Page.
# Do NOT invent a fake m.me URL.
# NEXT_PUBLIC_MESSENGER_URL=https://m.me/YourPageUsername

# —— Meta Messenger (env-token dual mode) ——
# Create in Meta Developer Console → your App → Messenger.
META_VERIFY_TOKEN=change-me-to-a-long-random-string
META_PAGE_ACCESS_TOKEN=
META_APP_SECRET=

# Optional. When set, webhook events from this Page ID map to the demo tenant
# using META_PAGE_ACCESS_TOKEN (operator-managed single-Page pilot).
# Unmapped Page IDs are refused — they never fall through to another tenant.
# META_PAGE_ID=

# —— ReplyPilot AI Connect ——
# Required for real Login with Facebook → Select Page → Connect.
# Without these, /dashboard/connect offers Demo Connect only.
META_APP_ID=
META_REDIRECT_URI=https://app.replypilotai.shop/api/connect/callback
# Local: META_REDIRECT_URI=http://localhost:3000/api/connect/callback
# META_APP_SECRET is reused for OAuth token exchange + webhook signature.

# —— Telegram ——
# No env vars. Each tenant creates their own bot in @BotFather and pastes the
# token into Settings → Telegram; it is stored encrypted with
# TOKEN_ENCRYPTION_KEY and the webhook is registered automatically.
#
# One requirement: NEXT_PUBLIC_APP_URL above must be a public https:// address,
# because that is where Telegram delivers updates. Localhost will be rejected
# with a clear error — use a tunnel (ngrok / cloudflared) while developing and
# point NEXT_PUBLIC_APP_URL at the tunnel URL.

# —— AI reply (OpenAI-compatible) ——
# If LLM is not configured, bot falls back to rule-based Bengali replies.
#
# Recommended: Ollama on your machine or Dedicated GCP VM (free models, no per-token bill).
# Install: https://ollama.com — then: ollama pull qwen2.5:7b-instruct && ollama pull nomic-embed-text
# Optional vision (customer photos): ollama pull llava:7b
AI_PROVIDER=ollama
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=qwen2.5:7b-instruct
# AI_VISION_MODEL=llava:7b
# AI_EMBED_MODEL=nomic-embed-text
# Remote Ollama on Google Cloud: AI_BASE_URL=http://YOUR_VM_IP:11434/v1
#
# Free cloud (needs API key, rate limits apply):
# AI_PROVIDER=groq
# GROQ_API_KEY=
# AI_MODEL=llama-3.3-70b-versatile
#
# AI_PROVIDER=gemini
# GEMINI_API_KEY=   # Google AI Studio — aistudio.google.com
# AI_MODEL=gemini-2.0-flash
#
# Paid / default OpenAI-compatible:
# OPENAI_API_KEY=
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# —— Dashboard / Admin ——
# Protects /dashboard and /api/admin/config.
# Demo login: admin@demo.replypilot.local + this password (default facetai-demo if unset locally).
# REQUIRED in production — set a strong, unique value.
ADMIN_PASSWORD=facetai-demo
